---
import '../styles/global.css';
interface Props { titulo: string; ativo: string }
const { titulo, ativo } = Astro.props;
const raiz = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['painel', '/', 'Painel'],
  ['dados', '/dados/', 'Levantamento'],
  ['indicadores', '/indicadores/', 'Indicadores'],
  ['base', '/base/', 'Base única'],
  ['conciliacao', '/conciliacao/', 'Conciliação'],
  ['parametros', '/parametros/', 'Parâmetros'],
  ['sobre', '/sobre/', 'Sobre'],
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href={raiz + "/favicon.png"} />
    <title>{titulo} · Indicadores Recomeçar</title>
  </head>
  <body>
    <header class="topo">
      <div class="topo-in">
        <a class="marca" href={raiz + "/"} aria-label="Re.Começar — painel de indicadores"><img src={raiz + "/logo-recomecar-clara.png"} alt="Re.Começar" width="190" height="34" /><small>Painel de indicadores sociais · ODS 4, 8 e 16</small></a>
        <nav class="menu" aria-label="Seções">
          {nav.map(([id, href, rot]) => <a href={raiz + href} aria-current={id === ativo ? 'page' : undefined}>{rot}</a>)}
        </nav>
        <div class="ferramentas">
          <span class="badge" id="badge-edicoes">dados publicados</span>
          <button id="btn-json" title="Baixa o JSON com todas as edições, para substituir src/data/indicadores.json">Exportar JSON</button>
          <button id="btn-csv">Exportar CSV</button>
          <button id="btn-import" data-so-edicao>Importar JSON</button>
          <button id="btn-reset" data-so-edicao>Descartar edições</button>
          <input type="file" id="arq-import" accept="application/json,.json" hidden />
        </div>
      </div>
    </header>
    <main><slot /></main>
    <script>
      import { iniciarBarra } from '../lib/ui';
      iniciarBarra();
    </script>
  </body>
</html>
