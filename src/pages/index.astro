---
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '../styles/painel.css';
const raiz = import.meta.env.BASE_URL.replace(/\/$/, '');
const dados = [['/dados/', 'Levantamento (editar)'], ['/indicadores/', 'Indicadores'], ['/base/', 'Base única'], ['/conciliacao/', 'Conciliação'], ['/parametros/', 'Parâmetros'], ['/sobre/', 'Sobre']];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href={raiz + '/favicon.png'} />
  <title>Painel de indicadores · Instituto Recomeçar</title>
</head>
<body>
<div class="app">
  <aside>
    <div class="brand">Instituto Recomeçar<small>Painel de indicadores</small></div>
    <div><div class="lab">Páginas</div><nav class="pages" id="nav" aria-label="Páginas do painel"></nav></div>
    <div><div class="lab">Ano</div><div class="slicer" id="seg"></div></div>
    <div>
      <div class="lab">Dados</div>
      <nav class="pages dados" aria-label="Dados e edição">
        {dados.map(([href, rot]) => <a href={raiz + href}>{rot}</a>)}
      </nav>
      <span class="badge" id="badge-edicoes">dados publicados</span>
    </div>
  </aside>
  <main>
    <div class="top"><h1 id="title"></h1><span class="per" id="per"></span></div>
    <section id="geral"><div class="cards" id="c-geral"></div><div class="vis"><div class="tile"><h3>Cadastrados e desenvolvidos por ano</h3><div class="leg" id="l1"></div><div class="fig" id="f1"></div></div><div class="tile"><h3>Geração de renda por vínculo</h3><div class="fig" id="f2"></div></div></div></section>
    <section id="trilha"><div class="cards" id="c-trilha"></div><div class="vis"><div class="tile"><h3>Etapas da trilha por ano</h3><div class="leg" id="l3"></div><div class="fig" id="f3"></div></div><div class="tile"><h3>Funil</h3><div class="fig" id="f4"></div></div></div></section>
    <section id="qualif"><div class="cards" id="c-qualif"></div><div class="vis one"><div class="tile"><h3>Matrículas e qualificações concluídas por ano</h3><div class="leg" id="l5"></div><div class="fig" id="f5"></div></div></div></section>
    <section id="emprego"><div class="cards" id="c-emprego"></div><div class="vis eq"><div class="tile"><h3>Geração de renda por vínculo</h3><div class="fig" id="f6"></div></div><div class="tile"><h3>Taxa de empregabilidade por ano</h3><div class="fig" id="f7"></div></div></div></section>
    <section id="empresas"><div class="cards" id="c-empresas"></div><div class="vis one"><div class="tile"><h3>Empresas parceiras e empresas que contrataram, por ano</h3><div class="leg" id="l8"></div><div class="fig" id="f8"></div></div></div></section>
    <section id="publico"><div class="cards" id="c-publico"></div><div class="vis one"><div class="tile"><h3>Outros públicos atendidos por ano</h3><div class="leg" id="l9"></div><div class="fig" id="f9"></div></div></div></section>
    <section id="reinc"><div class="cards" id="c-reinc"></div><div class="vis one"><div class="tile"><h3>Reincidência</h3><div class="fig" id="f10" style="min-height:220px"></div></div></div></section>
    <p class="foot">2026 é período parcial. Reincidência: CNJ acompanha 4 a 5 anos; Recomeçar, até 12 meses.</p>
  </main>
</div>
<script>
  import { iniciarBarra } from '../lib/ui';
  import { iniciarPainel } from '../lib/painel';
  iniciarBarra();
  iniciarPainel();
</script>
</body>
</html>
