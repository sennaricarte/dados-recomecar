---
import Base from '../layouts/Base.astro';
---
<Base titulo="Painel" ativo="painel">
  <h1>Painel de indicadores</h1>
  <p class="sub">Entregas, resultados e impactos do Instituto Recomeçar. Clique em uma barra para filtrar o período; clique na legenda para ocultar séries. Os números podem ser editados em <a href="./dados/">Levantamento</a>.</p>

  <div class="filtros">
    <label>Período dos cartões <select id="f-periodo"></select></label>
    <label>Gráficos: de <select id="f-de"></select></label>
    <label>até <select id="f-ate"></select></label>
    <label class="chk"><input type="checkbox" id="f-parcial" checked /> Incluir 2026 (parcial)</label>
  </div>

  <section class="kpis" id="kpis" aria-label="Indicadores principais"></section>

  <section class="grade">
    <div class="card"><h2>Trilha do egresso por ano</h2><p class="nota">Cadastrados → socializados → desenvolvidos (pessoas)</p><div class="chart"><canvas id="g-trilha" role="img" aria-label="Barras agrupadas: cadastrados, socializados e desenvolvidos por ano"></canvas></div></div>
    <div class="card"><h2>Funil do período selecionado</h2><p class="nota" id="n-funil"></p><div class="chart"><canvas id="g-funil" role="img" aria-label="Funil: cadastrados, socializados, desenvolvidos e geração de renda"></canvas></div></div>
    <div class="card"><h2>Qualificação profissional</h2><p class="nota">Matrículas e certificados concluídos por ano</p><div class="chart"><canvas id="g-qualif" role="img" aria-label="Matrículas e qualificações concluídas por ano"></canvas></div></div>
    <div class="card"><h2>Geração de renda por vínculo</h2><p class="nota">CLT, PJ/MEI/cooperado/freelancer e empreendedores (pessoas)</p><div class="chart"><canvas id="g-renda" role="img" aria-label="Barras empilhadas de geração de renda por vínculo"></canvas></div></div>
    <div class="card"><h2>Taxa de empregabilidade</h2><p class="nota">Geração de renda ÷ egressos desenvolvidos (RES-02)</p><div class="chart"><canvas id="g-taxa" role="img" aria-label="Linha da taxa de empregabilidade por ano"></canvas></div></div>
    <div class="card"><h2>Outros públicos atendidos</h2><p class="nota">Reeducandos, familiares, jovens em risco e líderes formados</p><div class="chart"><canvas id="g-outros" role="img" aria-label="Barras empilhadas de outros públicos"></canvas></div></div>
    <div class="card"><h2>Perfil dos atendidos</h2><p class="nota">% sobre o total de cadastrados no ano</p><div class="chart"><canvas id="g-perfil" role="img" aria-label="Linhas do perfil dos atendidos"></canvas></div></div>
    <div class="card"><h2>Rede de empresas</h2><p class="nota">Empresas parceiras × empresas que contrataram egressos</p><div class="chart"><canvas id="g-empresas" role="img" aria-label="Empresas parceiras e empresas que contrataram por ano"></canvas></div></div>
    <div class="card larga"><h2>Reincidência</h2><p class="nota" id="n-reinc"></p><div class="chart" style="height:230px"><canvas id="g-reinc" role="img" aria-label="Comparação de taxas de reincidência"></canvas></div></div>
  </section>
  <p class="rodape">* 2026 é período parcial; “Até 2020” reúne vários anos, então não é comparável a um ano isolado. Indicadores de impacto (reincidência, economia, ROI) são estimativas e dependem das premissas em <a href="./parametros/">Parâmetros</a>; a taxa nacional (CNJ) acompanha 4–5 anos e a do Recomeçar até 12 meses, então não são diretamente comparáveis.</p>

  <script>
    import { Chart, BarController, BarElement, LineController, LineElement, PointElement, CategoryScale, LinearScale, Tooltip, Legend } from 'chart.js';
    import { getDados, getCalc, onChange } from '../lib/store';
    import { compacto, esc, formatar } from '../lib/format';
    import { param } from '../lib/calc';

    Chart.register(BarController, BarElement, LineController, LineElement, PointElement, CategoryScale, LinearScale, Tooltip, Legend);
    Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
    Chart.defaults.color = '#6a686b';
    Chart.defaults.borderColor = '#ece9e6';

    // Paleta categórica em ordem fixa; a cor segue a entidade, nunca o ranking
    const COR = { vinho: '#782932', amarelo: '#ffca00', grafite: '#3f3e40', verde: '#00b894' };
    const ORDINAL = ['#d4a5ac', '#b5707a', '#97424f', '#782932']; // funil: tons de vinho, claro→escuro

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const selP = $<HTMLSelectElement>('f-periodo'), selDe = $<HTMLSelectElement>('f-de'), selAte = $<HTMLSelectElement>('f-ate'), chkP = $<HTMLInputElement>('f-parcial');
    const d0 = getDados();
    const rot = (a: string) => (a === d0.meta.parcial ? `${a}*` : a);
    selP.add(new Option('Acumulado (todos os anos)', 'acum'));
    d0.meta.anos.forEach((a, i) => { selP.add(new Option(rot(a), String(i))); selDe.add(new Option(a, String(i))); selAte.add(new Option(a, String(i))); });
    selDe.value = '0'; selAte.value = String(d0.meta.anos.length - 1);

    const charts = new Map<string, Chart>();
    function montar(id: string, cfg: any) {
      charts.get(id)?.destroy();
      cfg.options = { responsive: true, maintainAspectRatio: false, animation: { duration: 250 },
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, boxHeight: 12, usePointStyle: false } }, ...(cfg.options?.plugins ?? {}) },
        ...cfg.options };
      charts.set(id, new Chart($<HTMLCanvasElement>(id), cfg));
    }

    const linhaStyle = (cor: string) => ({ borderColor: cor, backgroundColor: cor, borderWidth: 2, pointRadius: 4, pointHoverRadius: 6, pointBorderColor: '#fff', pointBorderWidth: 2, tension: 0, spanGaps: false });
    const barStyle = (cor: string) => ({ backgroundColor: cor, borderColor: '#fff', borderWidth: 1.5, borderRadius: 4, borderSkipped: 'bottom', maxBarThickness: 34 });

    function render() {
      const d = getDados(), c = getCalc();
      const ate = Math.min(Number(selAte.value), chkP.checked ? 99 : d.meta.anos.length - 2);
      const de = Math.min(Number(selDe.value), ate);
      const idx = d.meta.anos.map((_, i) => i).filter((i) => i >= de && i <= ate);
      const labels = idx.map((i) => rot(d.meta.anos[i]));
      const S = (cod: string) => idx.map((i) => c.ind[cod][i]);
      const L = (id: string) => idx.map((i) => c.lev[id][i]);
      const un = (cod: string) => d.indicadores.find((m) => m.codigo === cod)!.unidade;
      const sel = selP.value === 'acum' ? 7 : Number(selP.value);

      // ---- cartões
      const kp: [string, string][] = [['ENT-01', 'Cadastrados'], ['ENT-02', 'Socializados'], ['ENT-03', 'Desenvolvidos'], ['ENT-06', 'Qualificações concluídas'], ['RES-01', 'Geração de renda'], ['RES-02', 'Taxa de empregabilidade'], ['ENT-13', 'Empresas que contrataram'], ['ENT-10', 'Atendimentos psicossociais']];
      $('kpis').innerHTML = kp.map(([cod, nome]) => {
        const m = d.indicadores.find((x) => x.codigo === cod)!;
        const v = c.ind[cod][sel], prev = sel >= 2 && sel <= 6 ? c.ind[cod][sel - 1] : null;
        let delta = selP.value === 'acum' ? 'todos os anos' : sel === 0 ? 'período anterior a 2021' : '';
        const parc = d.meta.anos[sel] === d.meta.parcial;
        if (parc && sel >= 2) delta = 'ano parcial — sem comparação';
        else if (prev !== null && v !== null && sel >= 2) {
          const dif = m.unidade === '%' ? (v - prev) * 100 : prev ? ((v - prev) / prev) * 100 : 0;
          const s = `${dif > 0 ? '+' : ''}${dif.toLocaleString('pt-BR', { maximumFractionDigits: 1 })}${m.unidade === '%' ? ' p.p.' : '%'}`;
          delta = `<b class="${dif >= 0 ? 'up' : 'down'}">${dif >= 0 ? '▲' : '▼'} ${s}</b> vs ${rot(d.meta.anos[sel - 1])}`;
        } else if (!delta) delta = sel === 1 ? 'primeiro ano da série' : 'sem ano anterior com dado';
        const partial = sel === d.meta.anos.indexOf(d.meta.parcial) ? ' (parcial)' : '';
        return `<div class="card kpi"><div class="rot"><span>${esc(nome)}${partial}</span><span class="ods">ODS ${esc(m.ods)}</span></div><div class="val">${v === null ? '—' : formatar(v, m.unidade)}</div><div class="delta">${delta}</div></div>`;
      }).join('');

      const porAno = { onClick: (_e: any, els: any[]) => { if (els.length) selP.value = String(idx[els[0].index]); render(); } };
      const yInt = { beginAtZero: true, ticks: { callback: (v: any) => compacto(Number(v)) }, grid: { color: '#efece9' } };
      const tip = (u: string) => ({ tooltip: { callbacks: { label: (ctx: any) => ` ${ctx.dataset.label}: ${formatar(ctx.parsed.y ?? ctx.parsed.x, u)}` } } });

      montar('g-trilha', { type: 'bar', data: { labels, datasets: [
        { label: 'Cadastrados', data: S('ENT-01'), ...barStyle(COR.vinho) }, { label: 'Socializados', data: S('ENT-02'), ...barStyle(COR.amarelo) }, { label: 'Desenvolvidos', data: S('ENT-03'), ...barStyle(COR.grafite) }] },
        options: { ...porAno, scales: { y: yInt }, plugins: tip('pessoas') } });

      // ---- funil
      const fun: [string, number | null][] = [['Cadastrados', c.ind['ENT-01'][sel]], ['Socializados', c.ind['ENT-02'][sel]], ['Desenvolvidos', c.ind['ENT-03'][sel]], ['Geração de renda', c.ind['RES-01'][sel]]];
      $('n-funil').textContent = `${selP.value === 'acum' ? 'Acumulado' : rot(d.meta.anos[sel])} — conversão entre etapas`;
      montar('g-funil', { type: 'bar', data: { labels: fun.map((f) => f[0]), datasets: [{ label: 'Pessoas', data: fun.map((f) => f[1]), backgroundColor: ORDINAL, borderRadius: 4, borderSkipped: 'start', maxBarThickness: 38 }] },
        options: { indexAxis: 'y', scales: { x: yInt, y: { grid: { display: false } } }, plugins: { legend: { display: false }, tooltip: { callbacks: { label: (ctx: any) => {
          const i = ctx.dataIndex, v = fun[i][1], p = i ? fun[i - 1][1] : null;
          return ` ${formatar(v, 'pessoas')} pessoas${p && v !== null ? ` (${((v / p) * 100).toLocaleString('pt-BR', { maximumFractionDigits: 1 })}% da etapa anterior)` : ''}`; } } } } } });

      montar('g-qualif', { type: 'bar', data: { labels, datasets: [{ label: 'Matriculados', data: S('ENT-05'), ...barStyle(COR.vinho) }, { label: 'Concluídas', data: S('ENT-06'), ...barStyle(COR.amarelo) }] },
        options: { ...porAno, scales: { y: yInt }, plugins: tip('pessoas') } });

      montar('g-renda', { type: 'bar', data: { labels, datasets: [
        { label: 'CLT', data: L('C01'), ...barStyle(COR.vinho), borderRadius: 0 }, { label: 'PJ/MEI/cooperado', data: L('C02'), ...barStyle(COR.amarelo), borderRadius: 0 }, { label: 'Empreendedores', data: L('C03'), ...barStyle(COR.grafite), borderRadius: 0 }] },
        options: { ...porAno, scales: { x: { stacked: true }, y: { ...yInt, stacked: true } }, plugins: tip('pessoas') } });

      montar('g-taxa', { type: 'line', data: { labels, datasets: [{ label: 'Taxa de empregabilidade', data: S('RES-02'), ...linhaStyle(COR.vinho) }] },
        options: { ...porAno, scales: { y: { beginAtZero: true, ticks: { callback: (v: any) => `${Number(v) * 100}%` }, grid: { color: '#efece9' } } }, plugins: { legend: { display: false }, ...tip('%') } } });

      montar('g-outros', { type: 'bar', data: { labels, datasets: [
        { label: 'Reeducandos', data: L('A04'), ...barStyle(COR.vinho), borderRadius: 0 }, { label: 'Familiares', data: L('A05'), ...barStyle(COR.amarelo), borderRadius: 0 },
        { label: 'Jovens em risco', data: L('A06'), ...barStyle(COR.grafite), borderRadius: 0 }, { label: 'Líderes formados', data: L('A07'), ...barStyle(COR.verde), borderRadius: 0 }] },
        options: { ...porAno, scales: { x: { stacked: true }, y: { ...yInt, stacked: true } }, plugins: tip('pessoas') } });

      montar('g-perfil', { type: 'line', data: { labels, datasets: [
        { label: 'Homens', data: L('G01'), ...linhaStyle(COR.vinho) }, { label: 'Pretos e pardos', data: L('G02'), ...linhaStyle(COR.amarelo) }, { label: 'Fund. incompleto', data: L('G03'), ...linhaStyle(COR.grafite) }] },
        options: { ...porAno, scales: { y: { min: 0, max: 1, ticks: { callback: (v: any) => `${Math.round(Number(v) * 100)}%` }, grid: { color: '#efece9' } } }, plugins: tip('%') } });

      montar('g-empresas', { type: 'line', data: { labels, datasets: [{ label: 'Empresas parceiras', data: L('F02'), ...linhaStyle(COR.vinho) }, { label: 'Empresas que contrataram', data: L('C06'), ...linhaStyle(COR.amarelo) }] },
        options: { ...porAno, scales: { y: yInt }, plugins: tip('nº') } });

      // ---- reincidência
      const nac = param(d, 'taxaNacional'), rec = param(d, 'reincidenciaRecomecar'), calc = c.ind['IMP-01'][7];
      const barras: [string, number | null, string][] = [['Nacional (CNJ, 4–5 anos)', nac, COR.grafite], ['Recomeçar — divulgada (até 12 meses)', rec, COR.vinho], ['Recomeçar — calculada pela base (D02 ÷ D01)', calc, COR.amarelo]];
      $('n-reinc').textContent = `Diferença para a taxa nacional: ${calc !== null && nac !== null ? formatar(nac - calc, 'p.p.') : '—'} (base: ${formatar(c.lev['D01'][7], 'pessoas')} egressos acompanhados, ${formatar(c.lev['D02'][7], 'pessoas')} reincidentes)`;
      montar('g-reinc', { type: 'bar', data: { labels: barras.map((b) => b[0]), datasets: [{ label: 'Taxa de reincidência', data: barras.map((b) => b[1]), backgroundColor: barras.map((b) => b[2]), borderRadius: 4, borderSkipped: 'start', maxBarThickness: 34 }] },
        options: { indexAxis: 'y', scales: { x: { beginAtZero: true, ticks: { callback: (v: any) => `${Number(v) * 100}%` }, grid: { color: '#efece9' } }, y: { grid: { display: false } } }, plugins: { legend: { display: false }, ...tip('%') } } });
    }

    [selP, selDe, selAte, chkP].forEach((e) => e.addEventListener('input', render));
    onChange(render);
    render();
  </script>
</Base>
